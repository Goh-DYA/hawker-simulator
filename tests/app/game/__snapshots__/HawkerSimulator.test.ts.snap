// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HawkerSimulator panels > renders the Activity panel for a captured runtime snapshot 1`] = `
"<aside class="catalogue-panel" aria-label="Activity panel">
<div class="catalogue-heading">
<div>
<span>Recent events</span>
<h2>Activity</h2>
</div>
<span class="count-badge">2</span>
<button type="button" class="sheet-close-button" aria-label="Close management sheet">×</button>
</div>
<div class="activity-panel">
<div class="activity-toolbar">
<span>Latest first · routine events stay here</span>
<button type="button">Clear</button>
</div>
<div class="activity-list">
<article data-kind="warning" data-importance="routine">
<span aria-hidden="true">!</span>
<div>
<strong>Attention</strong>
<p>A guest rerouted after the layout changed.</p>
</div>
</article>
<article data-kind="success" data-importance="routine">
<span aria-hidden="true">✓</span>
<div>
<strong>Completed</strong>
<p>2 neighbours enjoyed their meals · +$11</p>
</div>
<em>×2</em>
</article>
</div>
</div>
</aside>"
`;

