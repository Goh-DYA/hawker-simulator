exports[`HawkerSimulator panels > renders the Insights panel for a captured runtime snapshot 1`] = `
"<aside class="catalogue-panel" aria-label="Centre insights panel">
<div class="catalogue-heading">
<div>
<span>Service review</span>
<h2>Centre insights</h2>
</div>
<span class="count-badge">14</span>
<button type="button" class="sheet-close-button" aria-label="Close management sheet">×</button>
</div>
<div class="insights-list">
<article data-state="good">
<span aria-hidden="true">↝</span>
<div>
<strong>Queue flow</strong>
<p>Approach paths are clear and queue pressure is comfortable.</p>
</div>
<em>21% used</em>
</article>
<article data-state="good">
<span aria-hidden="true">◒</span>
<div>
<strong>Communal seating</strong>
<p>2 seats are ready for arriving diners.</p>
<p class="seating-clearing-note">1 seat waiting for the table-cleaning crew (crew of 1).</p>
</div>
<em>2/6</em>
</article>
<article data-state="neutral">
<span aria-hidden="true">♥</span>
<div>
<strong>Reputation</strong>
<p>Reputation now 6. Best reputation reached: 8 — unlocks use this, so nothing locks again after a quieter day.</p>
</div>
<em>8</em>
</article>
<article data-state="good">
<span aria-hidden="true">★</span>
<div>
<strong>Centre journey</strong>
<p>1 permanent milestones completed.</p>
<dl class="milestone-progress-list">
<div>
<dt>Service tier 0</dt>
<dd>4 / 50</dd>
</div>
<div>
<dt>Hospitality tier 0</dt>
<dd>17 / 75</dd>
</div>
<div>
<dt>Variety tier 1</dt>
<dd>2 / 4</dd>
</div>
<div>
<dt>Growth tier 0</dt>
<dd>2 / 3</dd>
</div>
</dl>
</div>
<em>1/16</em>
</article>
<article data-state="warning">
<span aria-hidden="true">♥</span>
<div>
<strong>Guest happiness</strong>
<p>Recent guest visits average 17%.</p>
<dl class="happiness-breakdown" aria-label="Guest happiness factors">
<div>
<dt>Food</dt>
<dd aria-label="Food 0 out of 100">0/100</dd>
</div>
<div>
<dt>Wait</dt>
<dd aria-label="Wait 100 out of 100">100/100</dd>
</div>
<div>
<dt>Value</dt>
<dd aria-label="Value 20 out of 100">20/100</dd>
</div>
<div>
<dt>Route efficiency</dt>
<dd aria-label="Route efficiency 96 out of 100">96/100</dd>
</div>
<div>
<dt>Comfort</dt>
<dd aria-label="Comfort 20 out of 100">20/100</dd>
</div>
<div>
<dt>Cleanliness</dt>
<dd aria-label="Cleanliness 70 out of 100">70/100</dd>
</div>
<div>
<dt>Ambience</dt>
<dd aria-label="Ambience 65 out of 100">65/100</dd>
</div>
</dl>
<div class="happiness-advice">
<b>Ways to improve</b>
<ul>
<li>
<strong>Food quality · 0</strong>
<span>Choose higher-quality dishes and buy stall mastery upgrades that raise quality.</span>
</li>
<li>
<strong>Value · 20</strong>
<span>Add a lower-cost menu option and choose dishes whose prices better suit visitor budgets.</span>
</li>
</ul>
</div>
</div>
<em>17%</em>
</article>
<article data-state="good">
<span aria-hidden="true">↺</span>
<div>
<strong>Tray return</strong>
<p>1 return point is visible and tables are turning over cleanly.</p>
</div>
<em>99%</em>
</article>
<article data-state="neutral">
<span aria-hidden="true">◎</span>
<div>
<strong>Customer personas</strong>
<p>3 of 12 distinct behaviour profiles can currently visit.</p>
<details class="persona-roster">
<summary>Browse the persona roster</summary>
<ul>
<li data-locked="false">
<strong>Early-Shift Regular</strong>
<span>Arrives early, knows what they want, values familiar breakfasts, and leaves quickly when a short queue stops moving.</span>
<small>Can visit now</small>
</li>
<li data-locked="false">
<strong>Office Lunch Sprinter</strong>
<span>Visits in the lunch rush with a firm time budget, preferring fast service and a seat close to the chosen stall.</span>
<small>Can visit now</small>
</li>
<li data-locked="false">
<strong>Student Saver</strong>
<span>Compares prices carefully, often arrives with friends, and will walk farther for filling food at a fair price.</span>
<small>Can visit now</small>
</li>
<li data-locked="true">
<strong>Afternoon Treat Stopper</strong>
<span>Drops in for a cooling drink or small sweet bite between commitments, prioritizing value and a fast-moving queue.</span>
<small>Level 3</small>
</li>
<li data-locked="true">
<strong>Family Table</strong>
<span>Arrives in a larger group, waits patiently for adjacent seats, and rewards menu variety, comfort, and cleanliness.</span>
<small>Level 3</small>
</li>
<li data-locked="true">
<strong>Plant-Forward Planner</strong>
<span>Chooses vegetable-forward meals based on quality, variety, and value, with a willingness to explore unfamiliar dishes.</span>
<small>Level 4</small>
</li>
<li data-locked="true">
<strong>Curious Food Explorer</strong>
<span>Actively seeks unfamiliar dishes, tolerates a celebrated queue, and responds strongly to quality and menu breadth.</span>
<small>Level 5</small>
</li>
<li data-locked="true">
<strong>Comfort-Seeking Regular</strong>
<span>Returns for familiar comfort dishes and places extra value on clear routes, supportive seating, shade, airflow, and a clean table.</span>
<small>Level 6</small>
</li>
<li data-locked="true">
<strong>Quiet Break Regular</strong>
<span>Takes an unhurried meal during quieter hours, accepting a modest queue and favouring familiar light dishes.</span>
<small>Level 7</small>
</li>
<li data-locked="true">
<strong>Evening Social Diner</strong>
<span>Meets friends after work, seeks breezy group seating, and lingers over shareable plates and drinks.</span>
<small>Level 8</small>
</li>
<li data-locked="true">
<strong>Night-Shift Recharger</strong>
<span>Visits near closing for a warm, dependable meal, preferring a direct route before the next part of the night.</span>
<small>Level 9</small>
</li>
<li data-locked="true">
<strong>Quality Treat Seeker</strong>
<span>Visits less often but spends freely on excellent signature dishes, polished surroundings, and attentive service.</span>
<small>Level 11</small>
</li>
</ul>
</details>
</div>
<em>3/12</em>
</article>
<button type="button" class="expansion-button" disabled="">
<span>Expand hall · plot 1</span>
<strong>Unlocks at level 3</strong>
<small>Add 4 × 2 buildable tiles</small>
</button>
</div>
</aside>"
`;

