# Optional environment for Hawker Balance. Nothing here is required: the game has no backend,
# so the build, tests and gameplay run without any of these set. Set them in the shell
# environment; no tool here loads .env files.

# Bypass token for Vercel deployment protection, read by the deploy smoke test
# (tools/smoke-deployment.mjs).
VERCEL_AUTOMATION_BYPASS_SECRET=

# Port for `vinext start`.
PORT=

# Node-side code that reads process.env outside the browser bundle:
# - next.config.ts reads NODE_ENV through src/config/env.ts.
# - vite.config.ts defaults WRANGLER_WRITE_LOGS, WRANGLER_LOG_PATH and MINIFLARE_REGISTRY_PATH.
# - tools/smoke-deployment.mjs reads VERCEL_AUTOMATION_BYPASS_SECRET.
