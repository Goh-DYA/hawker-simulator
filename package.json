{
  "name": "hawker-simulator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/stamp-service-worker.mjs",
    "build": "vinext build",
    "build:vercel": "node tools/stamp-service-worker.mjs && next build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ssr": "node --throw-deprecation --test tests/rendered-html.test.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:ssr",
    "smoke:deployment": "node tools/smoke-deployment.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check",
    "validate:content": "vitest run --config vitest.config.ts tests/content/content.test.ts"
  },
  "dependencies": {
    "idb": "8.0.3",
    "next": "16.4.3",
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@napi-rs/canvas": "1.0.11",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "image-size": "2.0.4",
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  },
  "type": "module"
}
